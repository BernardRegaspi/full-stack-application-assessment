# MySQL connection string used by Prisma
DATABASE_URL=mysql://food:food@localhost:3306/food_search

# Seeded demo user email (must match the seed)
DEMO_USER_EMAIL=demo@example.com

# Stripe test-mode secret key (sk_test_...)
STRIPE_SECRET_KEY=sk_test_replace_me

# Webhook signing secret from Stripe CLI (`stripe listen`) or Dashboard
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Test-mode Price ID (must start with price_, not an amount like 4.99)
STRIPE_PRICE_ID=price_replace_me

# Allowed browser origin for CORS and Checkout return URLs
FRONTEND_ORIGIN=http://localhost:3000

# Port for the Express server
PORT=4000
